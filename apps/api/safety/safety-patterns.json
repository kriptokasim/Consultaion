{
  "version": 1,
  "patterns": [
    {
      "name": "token_url",
      "category": "token",
      "source": "https?://[^\\s]+[?&](?:token|key|secret|api_key|access_token|auth)=[^\\s&]+",
      "case_insensitive": true,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_URL]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "bearer_token",
      "category": "token",
      "source": "Bearer\\s+[A-Za-z0-9._~+/=-]+",
      "case_insensitive": true,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_TOKEN]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "jwt",
      "category": "token",
      "source": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_TOKEN]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "secret_assignment",
      "category": "secret",
      "source": "(?:PASSWORD|SECRET|API_KEY|APIKEY|ACCESS_TOKEN|AUTH_TOKEN|PRIVATE_KEY|SECRET_KEY|ENCRYPTION_KEY)\\s*[=:]\\s*\\S+",
      "case_insensitive": true,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_SECRET]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "openai_project_key",
      "category": "provider_key",
      "source": "sk-proj-[A-Za-z0-9-]{20,}",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_API_KEY]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "anthropic_key",
      "category": "provider_key",
      "source": "sk-ant-[A-Za-z0-9-]{20,}",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_API_KEY]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "openai_key",
      "category": "provider_key",
      "source": "sk-[A-Za-z0-9]{20,}",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_API_KEY]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "google_key",
      "category": "provider_key",
      "source": "AIza[A-Za-z0-9_-]{30,}",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_API_KEY]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "groq_key",
      "category": "provider_key",
      "source": "gsk_[A-Za-z0-9]{20,}",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_API_KEY]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "xai_key",
      "category": "provider_key",
      "source": "xai-[A-Za-z0-9]{20,}",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_API_KEY]",
      "platform": "shared",
      "consumers": ["text_safety"]
    },
    {
      "name": "email",
      "category": "pii",
      "source": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "case_insensitive": true,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_EMAIL]",
      "platform": "shared",
      "consumers": ["text_safety", "pii"]
    },
    {
      "name": "phone",
      "category": "pii",
      "source": "(?:\\+\\d{1,3}[-.\\s]?)?(?:\\(\\d{3}\\)|\\b\\d{3})[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_PHONE]",
      "platform": "shared",
      "consumers": ["text_safety", "pii"]
    },
    {
      "name": "card_candidate",
      "category": "payment_card",
      "source": "\\b(?:\\d[ -]?){12,18}\\d\\b",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_CC]",
      "platform": "shared",
      "consumers": ["text_safety"],
      "validator": "luhn"
    },
    {
      "name": "high_entropy_token",
      "category": "secret",
      "source": "\\b[A-Za-z0-9+/]{40,}={0,2}\\b",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": false,
      "enabled_in_redaction": false,
      "replacement": "[REDACTED_SECRET]",
      "platform": "backend",
      "consumers": ["text_safety"]
    },
    {
      "name": "name_heuristic",
      "category": "pii",
      "source": "\\b([A-Z][a-z]+(?:\\s+[A-Z][a-z]+){1,3})\\b",
      "case_insensitive": false,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_NAME]",
      "platform": "backend",
      "consumers": ["pii"]
    },
    {
      "name": "address_heuristic",
      "category": "pii",
      "source": "\\b\\d+\\s+[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*\\s+(?:Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Lane|Ln|Drive|Dr|Court|Ct)\\b",
      "case_insensitive": true,
      "global_for_redaction": true,
      "enabled_in_detection": true,
      "enabled_in_redaction": true,
      "replacement": "[REDACTED_ADDRESS]",
      "platform": "backend",
      "consumers": ["pii"]
    }
  ]
}
